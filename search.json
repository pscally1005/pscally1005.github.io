---
layout: none
---
[
  {%- assign live_posts = site.posts
    | where_exp: "post", "post.categories.last != 'Archive'"
    | where_exp: "post", "post.categories.last != 'Draft'"
    | where_exp: "post", "post.categories.last != 'Delete'"
    | where_exp: "post", "post.categories.last != 'Hidden'"
  -%}

  {%- assign date_format = site.minima.date_format | default: "%b %-d, %Y" -%}

  {%- for post in live_posts -%}
    {%- assign gluten_free = "true" -%}
    {%- assign vegetarian = "true" -%}
    {%- assign dairy_free = "true" -%}
    {%- assign vegan = "true" -%}
    {%- assign nut_free = "true" -%}
    {%- assign sugar_free = "true" -%}
    {%- assign high_protein = "true" -%}

    {%- assign file = post.file -%}
    {%- assign ing = file | append: "-ing" -%}
    {%- assign facts = file | append: "-facts" -%}

    {% if file %}

      {%- for row in site.data[ing] -%}
          {% unless forloop.last %}
              {% assign food = row["Ingredient"] %}
              {%- for row1 in site.data.foods -%}
                  {% if food == row1["Food"] %}
                      {% if row1["Gluten Free"] == "FALSE" %}
                          {% assign gluten_free = "false" %}
                      {% endif %}
                      {% if row1["Vegetarian"] == "FALSE" %}
                          {% assign vegetarian = "false" %}
                      {% endif %}
                      {% if row1["Dairy Free"] == "FALSE" %}
                          {% assign dairy_free = "false" %}
                      {% endif %}
                      {% if row1["Vegan"] == "FALSE" %}
                          {% assign vegan = "false" %}
                      {% endif %}
                      {% if row1["Nut Free"] == "FALSE" %}
                          {% assign nut_free = "false" %}
                      {% endif %}
                      {% if row1["Sugar Free"] == "FALSE" %}
                          {% assign sugar_free = "false" %}
                      {% endif %}
                  {% endif %}
              {% endfor %}
          {% endunless %}
      {% endfor %}

      {%- assign calories = "0" -%}
      {%- assign protein = "0" -%}
      {%- for row in site.data[facts] -%}
          {%- assign nutrient = row["Nutrient"] -%}
          {%- assign amount = row["Amount"] -%}
          {% if nutrient == "Calories" %}
              {%- assign calories = amount -%}
          {% elsif nutrient == "Protein" %}
              {%- assign protein = amount -%}
          {% endif %}
      {% endfor %}

      {%- assign calories = calories | plus: 0 | floor -%}
      {%- assign protein = protein | plus: 0 | ceil -%}
      {%- assign protein_per_100kcal = 0 -%}

      {% if calories >= 10 %}
        {%- assign protein_per_100kcal = protein | times: 100 | divided_by: calories -%}
      {% endif %}

      {% if protein_per_100kcal >= 10 %}
          {%- assign high_protein = "true" -%}
      {% else %}
          {%- assign high_protein = "false" -%}
      {% endif %}

    {% else %}
      {%- assign gluten_free = "false" -%}
      {%- assign vegetarian = "false" -%}
      {%- assign dairy_free = "false" -%}
      {%- assign vegan = "false" -%}
      {%- assign nut_free = "false" -%}
      {%- assign sugar_free = "false" -%}
      {%- assign high_protein = "false" -%}
    {% endif %}

    {% if post.categories[0] == "Misc." and post.categories[1] != "Unhealthy Recipes" %}
      {%- assign gluten_free = "false" -%}
      {%- assign vegetarian = "false" -%}
      {%- assign dairy_free = "false" -%}
      {%- assign vegan = "false" -%}
      {%- assign nut_free = "false" -%}
      {%- assign sugar_free = "false" -%}
      {%- assign high_protein = "false" -%}
    {% endif %}

    {% if post.title == "Food/Nutrition Meme Dump" %}
      {%- assign gluten_free = "false" -%}
      {%- assign vegetarian = "false" -%}
      {%- assign dairy_free = "false" -%}
      {%- assign vegan = "false" -%}
      {%- assign nut_free = "false" -%}
      {%- assign sugar_free = "false" -%}
      {%- assign high_protein = "false" -%}
    {% endif %}

    {
      "title"    : "{{ post.title | escape }}",
      "url"      : "{{ site.baseurl }}{{ post.url }}",
      "categories": "{{ post.categories }}",
      "date"     : "{{ post.date | date: date_format }}",
      "tags": "{{ post.tags | join: ', ' }}",
      "image"    : "{{ post.image }}",
      "ingred"   : "{{ ing }}",
      "gluten_free": "{{ gluten_free }}",
      "vegetarian": "{{ vegetarian }}",
      "dairy_free": "{{ dairy_free }}",
      "vegan": "{{ vegan }}",
      "nut_free": "{{ nut_free }}",
      "sugar_free": "{{ sugar_free }}",
      "high_protein": "{{ high_protein }}"
    }
    {%- unless forloop.last -%},{%- endunless -%}
  {%- endfor -%}
]
