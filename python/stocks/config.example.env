# Copy to config.env and fill in your values (local runs).
# For GitHub Actions: add the same keys as repository secrets (see .github/workflows/stock_52_week_report.yml).
#
# Gmail: use an App Password (Google Account > Security > 2-Step Verification > App passwords).

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASSWORD=your-app-password

EMAIL_FROM=your.email@gmail.com
EMAIL_TO=your.email@gmail.com

# How close to the 52-week extreme counts as "at" the high/low (percent).
TOLERANCE_PCT=0.5
