# Copy to config.env and fill in your values (local runs).
# For GitHub Actions: add the same keys as repository secrets (see .github/workflows/stock_52_week_report.yml).
#
# Gmail: use an App Password (Google Account > Security > 2-Step Verification > App passwords).

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASSWORD=your-app-password

# Sender shown on each email (use your Gmail address)
EMAIL_FROM=poormanprotein@gmail.com

# Optional: only used if subscribers.json is empty (normally use /misc/stocks instead)
# EMAIL_TO=you@gmail.com

# Unsubscribe link base (each subscriber gets ?token=...)
UNSUBSCRIBE_BASE_URL=https://www.poormanprotein.com/misc/stocks/unsubscribe

# How close to the 52-week extreme counts as "at" the high/low (percent).
TOLERANCE_PCT=0.5
